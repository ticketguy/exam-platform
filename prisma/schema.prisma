generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

enum ExamAttemptStatus {
  in_progress
  completed
  invalidated
}

enum DepositStatus {
  pending
  confirmed
  failed
}

enum WithdrawalStatus {
  queued
  pending
  sent
  failed
  blocked
}

enum TransactionType {
  deposit
  withdrawal
  adjustment
  exam_fee
  exam_winnings
}

enum TriggeredBy {
  system
  user
  admin
}

model User {
  id                     String    @id @default(cuid())
  name                   String
  nickname               String    @unique
  email                  String    @unique
  passwordHash           String
  role                   UserRole  @default(user)
  avatar                 String?
  bio                    String?
  emailVerified          Boolean   @default(false)
  emailVerificationToken String?
  emailVerifiedAt        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  wallet        Wallet?
  examAttempts  ExamAttempt[]
  transactions  Transaction[]
  deposits      Deposit[]
  withdrawals   Withdrawal[]
  notifications Notification[]

  adminTransactions Transaction[] @relation("AdminTransactions")
}

model Exam {
  id          String    @id @default(cuid())
  title       String
  description String?
  category    String
  difficulty  String
  duration    Int // minutes
  passmark    Int // percentage
  entryFee    Float     @default(0)
  prizePool   Float     @default(0)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  questions    Question[]
  examAttempts ExamAttempt[]
}

model Question {
  id            String @id @default(cuid())
  examId        String
  questionText  String
  options       Json // string[]
  correctAnswer Int // index of correct option
  points        Int    @default(1)
  orderIndex    Int    @default(0)

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

model ExamAttempt {
  id          String            @id @default(cuid())
  userId      String
  examId      String
  score       Float             @default(0)
  totalPoints Int               @default(0)
  maxPoints   Int               @default(0)
  passed      Boolean           @default(false)
  timeSpent   Int               @default(0) // seconds
  answers     Json? // Record<questionId, selectedIndex>
  status      ExamAttemptStatus @default(in_progress)
  startedAt   DateTime          @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id])
  exam Exam @relation(fields: [examId], references: [id])

  @@index([userId, examId])
  @@index([userId])
  @@index([examId])
}

model Wallet {
  id         String   @id @default(cuid())
  userId     String   @unique
  balance    Float    @default(0)
  dgbAddress String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  type          TransactionType
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  triggeredBy   TriggeredBy
  adminId       String?
  reason        String?
  notes         String?
  relatedId     String?
  createdAt     DateTime        @default(now())

  user  User  @relation(fields: [userId], references: [id])
  admin User? @relation("AdminTransactions", fields: [adminId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Deposit {
  id             String        @id @default(cuid())
  userId         String
  amount         Float
  txid           String?
  status         DepositStatus @default(pending)
  confirmations  Int           @default(0)
  depositAddress String
  creditedAmount Float         @default(0)
  createdAt      DateTime      @default(now())
  confirmedAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([txid])
  @@index([status])
}

model Withdrawal {
  id                 String           @id @default(cuid())
  userId             String
  amount             Float
  destinationAddress String
  txid               String?
  status             WithdrawalStatus @default(queued)
  fee                Float            @default(0)
  confirmations      Int              @default(0)
  failureReason      String?
  blockReason        String?
  createdAt          DateTime         @default(now())
  sentAt             DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model PlatformSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("platform_settings")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, read])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("waitlist_entries")
}
