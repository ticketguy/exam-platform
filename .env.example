# ─── NextAuth ────────────────────────────────────────────────
# Random secret for JWT signing. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-this-to-a-random-secret-in-production

# The canonical URL of the Next.js frontend (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ─── FastAPI Backend ─────────────────────────────────────────
# URL where the FastAPI (exam-api) service is running
# In production: https://api.yourdomain.com
API_URL=http://localhost:8000