# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string. Use ?sslmode=require in production.
DATABASE_URL=postgresql://user:password@localhost:5432/nocho

# ─── JWT ─────────────────────────────────────────────────────
# Random secret for signing JWT tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-in-production

# JWT algorithm — leave as HS256 unless you have a reason to change
ALGORITHM=HS256

# How long JWT tokens last in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440